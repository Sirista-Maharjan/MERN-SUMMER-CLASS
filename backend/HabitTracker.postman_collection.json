{
  "info": {
    "name": "Habit Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "authUrl", "value": "http://localhost:5000/api/auth" },
    { "key": "baseUrl", "value": "http://localhost:5000/api/habits" },
    { "key": "token", "value": "" },
    { "key": "habitId", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{authUrl}}/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{authUrl}}/login"
      }
    },
    {
      "name": "Get all habits (requires token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "Create habit (requires token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Meditate\",\n  \"frequency\": \"daily\"\n}"
        },
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "Complete habit (today)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"localDate\": \"2026-07-28\"\n}"
        },
        "url": "{{baseUrl}}/{{habitId}}/complete"
      }
    },
    {
      "name": "Complete habit again (expect 409 duplicate)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"localDate\": \"2026-07-28\"\n}"
        },
        "url": "{{baseUrl}}/{{habitId}}/complete"
      }
    },
    {
      "name": "Get habit history",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/{{habitId}}/history"
      }
    },
    {
      "name": "Delete habit",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/{{habitId}}"
      }
    },
    {
      "name": "Get habits without token (expect 401)",
      "request": { "method": "GET", "url": "{{baseUrl}}" }
    },
    {
      "name": "Get AI coaching tips",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "http://localhost:5000/api/ai/coach"
      }
    }
  ]
}
